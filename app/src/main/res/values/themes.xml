<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- =========================================================== -->
    <!-- TEMA PREMIUM OSCURO - PROFESIONAL Y CORPORATIVO              -->
    <!-- =========================================================== -->
    <style name="Base.Theme.TFGAplicacion" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colores Primarios -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryContainer">@color/surface</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Colores Secundarios -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/surface_variant</item>

        <!-- Colores de Fondo -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- Status Bar y Navigation -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Textos -->
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Errores -->
        <item name="colorError">@color/error</item>
    </style>

    <style name="Theme.TFGAplicacion" parent="Base.Theme.TFGAplicacion" />

    <style name="AdiccionTheme" parent="Base.Theme.TFGAplicacion" />

    <!-- =========================================================== -->
    <!-- ESTILOS DE CARD - DISEÑO PREMIUM                             -->
    <!-- =========================================================== -->
    <style name="CardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <style name="CardStyle.Contador">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="CardStyle.Info">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="CardStyle.Glow">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <!-- =========================================================== -->
    <!-- ESTILOS DE TEXTO - TIPOGRAFÍA PREMIUM                        -->
    <!-- =========================================================== -->
    <style name="TextStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TitleText">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="SubtitleText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BigNumberText">
        <item name="android:textSize">56sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <style name="LabelText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- =========================================================== -->
    <!-- BOTONES - DISEÑO MODERNO                                     -->
    <!-- =========================================================== -->
    <style name="ButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ButtonStyle.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="ButtonStyle.Registrar" parent="ButtonStyle">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">60dp</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="ButtonStyle.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ButtonStyle.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- =========================================================== -->
    <!-- TABS - DISEÑO ELEGANTE                                        -->
    <!-- =========================================================== -->
    <style name="TabLayoutStyle" parent="Widget.Material3.TabLayout">
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabRippleColor">@color/primary_light</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
    </style>

    <!-- =========================================================== -->
    <!-- TOOLBAR - DISEÑO FLUIDO                                      -->
    <!-- =========================================================== -->
    <style name="ToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <!-- =========================================================== -->
    <!-- PROGRESS - INDICADORES MODERNOS                              -->
    <!-- =========================================================== -->
    <style name="ProgressStyle" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">10dp</item>
        <item name="trackCornerRadius">5dp</item>
        <item name="trackColor">@color/surface_variant</item>
        <item name="indicatorColor">@color/primary</item>
    </style>

    <style name="ProgressStyle.Small" parent="ProgressStyle">
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
    </style>

    <!-- =========================================================== -->
    <!-- INPUT FIELDS - CAMPOS ELEGANANTES                            -->
    <!-- =========================================================== -->
    <style name="TextInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- =========================================================== -->
    <!-- DIALOGS - MODALES PREMIUM                                     -->
    <!-- =========================================================== -->
    <style name="DialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogShapeAppearance</item>
        <item name="colorSurface">@color/surface</item>
    </style>

    <style name="DialogShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- =========================================================== -->
    <!-- BOTTOM NAVIGATION - SI SE USA EN EL FUTURO                   -->
    <!-- =========================================================== -->
    <style name="BottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNavIndicator</item>
    </style>

    <style name="BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary</item>
    </style>
</resources>